# Runtime environment
PROJECT_ENV=development

# OpenAQ
# Register your own key and store it in .env, never in this example file.
OPENAQ_API_KEY=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_PROFILE=

# Use local for development and s3 after AWS is configured.
RAW_BACKEND=local
LOCAL_RAW_ROOT=data/raw

# Local analytical warehouse
DUCKDB_PATH=data/warehouse/vn_air_quality_weather.duckdb

# HTTP resilience for Open-Meteo and OpenAQ.
# Retries cover 408/425/429/5xx and transport errors; Retry-After wins over backoff.
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_ATTEMPTS=5
HTTP_BACKOFF_BASE_SECONDS=0.5
HTTP_BACKOFF_MAX_SECONDS=30

# Optional Telegram alert channel. Keep real values in .env only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_COOLDOWN_MINUTES=180
ALERT_MAX_DATA_AGE_MINUTES=180

# Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0-python3.11
# Every Airflow container must sign and verify task-execution JWTs with the same
# secret. Left unset, each one generates its own and every scheduled task dies
# with "Invalid auth token" and an empty task log. docker-compose.yml falls back
# to a dev value; set a real one here for anything that is not a local machine.
AIRFLOW_JWT_SECRET=local-dev-shared-jwt-secret

# SQL Server serving database. DuckDB stays the analytical warehouse; these marts
# are republished into SQL Server after every pipeline run so the web application
# reads a server built for concurrent readers instead of taking the warehouse lock.
# Keep the real password in .env only, never here, and prefer a login that holds
# only the rights it needs over reusing sa.
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=vn_air_quality
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DRIVER=ODBC Driver 18 for SQL Server
# Driver 18 encrypts by default and then verifies the certificate. A local instance
# signs its own, so trusting it is correct here and wrong anywhere else.
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=true
