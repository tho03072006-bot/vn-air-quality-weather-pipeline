# Runtime environment
PROJECT_ENV=development

# OpenAQ
# Register your own key and store it in .env, never in this example file.
OPENAQ_API_KEY=

# AWS S3
AWS_REGION=
AWS_S3_BUCKET=
AWS_PROFILE=

# Use local for development and s3 after AWS is configured.
RAW_BACKEND=local
LOCAL_RAW_ROOT=data/raw

# Local analytical warehouse
DUCKDB_PATH=data/warehouse/vn_air_quality_weather.duckdb

# Airflow
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.0-python3.11
